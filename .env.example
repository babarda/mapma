# ---------------------------------------------------------------------------
# MAPMA environment variables. Copy this file to `.env.local` and fill in.
# Everything below is OPTIONAL for the foundation/map to render:
# with no keys set, the map falls back to free OpenFreeMap tiles.
# ---------------------------------------------------------------------------

# --- Map tiles (MapTiler) ---------------------------------------------------
# Free tier: https://www.maptiler.com/  (100k tile loads / month)
# When set, the map upgrades to a sepia "museum" style automatically.
# Must be NEXT_PUBLIC_ because the map renders client-side.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Supabase (Postgres + PostGIS + Auth) -----------------------------------
# https://supabase.com/ -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Used by API routes / admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (image storage, S3-compatible) ---------------------------
# https://dash.cloudflare.com/ -> R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mapma
# Public base URL of the bucket (custom domain or *.r2.dev), no trailing slash.
R2_PUBLIC_URL=

# --- Google Gemini (AI vision: location/era/description extraction) ---------
# https://aistudio.google.com/app/apikey  (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
